# ---------------------------------------------------------------------------
# Infraestrutura
# ---------------------------------------------------------------------------

# Postgres do app. No Supabase: Connect → Transaction pooler (porta 6543).
#
# Atenção: NÃO use a conexão direta (db.<ref>.supabase.co). A Supabase só a
# publica em IPv6 e ela falha com ENOTFOUND em rede sem rota IPv6.
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres"

# Usada só pelas migrations. No Supabase: Connect → Session pooler (5432).
# O modo transaction multiplexa conexões e não sustenta o DDL do drizzle-kit.
MIGRATE_DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Segredos
# ---------------------------------------------------------------------------

# 32 bytes em base64. Cifra as credenciais das caixas de envio.
#   openssl rand -base64 32
ENCRYPTION_KEY=""

# Assina os tokens de descadastro e o endereço de Reply-To.
#   openssl rand -hex 32
TOKEN_SECRET=""

# Senha de acesso ao painel (v1: workspace único).
APP_PASSWORD=""

# Protege /api/cron/tick — o endpoint que dispara os envios.
#   openssl rand -hex 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------

# Base pública. Entra no link de descadastro de todo e-mail — precisa ser
# alcançável pela internet, senão o botão nativo do Gmail falha.
APP_URL="http://localhost:3000"

# Domínio configurado no Resend Inbound para receber as respostas.
# É o que torna a parada por resposta determinística.
INBOUND_DOMAIN="inbound.seudominio.com.br"

# Segredo do endpoint de webhook (Resend usa Svix). Sem ele o endpoint aceita
# qualquer POST — e ele suprime contatos e encerra cadências.
RESEND_WEBHOOK_SECRET=""

# Necessária mesmo quando o envio é por SMTP: o webhook `email.received`
# entrega só metadados, e o corpo da resposta é buscado com esta chave.
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# Verificação (npm run doctor / npm run smoke)
# ---------------------------------------------------------------------------

# Domínio de onde os e-mails saem. Habilita os checks de SPF, DKIM e DMARC.
SENDING_DOMAIN="seudominio.com.br"

# Remetente usado pelo smoke test.
SMOKE_FROM_EMAIL="diego@seudominio.com.br"

# Caminho testado: "resend" ou "smtp".
SMOKE_PROVIDER="smtp"

# Caminho Resend: usa os endereços @resend.dev automaticamente.
RESEND_API_KEY=""

# Caminho SMTP: precisa de uma caixa sua como destino, porque os endereços
# @resend.dev só se comportam como teste dentro da API do Resend.
SMOKE_TO_EMAIL="voce@gmail.com"
SMOKE_SMTP_HOST="smtp.gmail.com"
SMOKE_SMTP_PORT=587
SMOKE_SMTP_SECURE=false
SMOKE_SMTP_USER="diego@seudominio.com.br"
SMOKE_SMTP_PASSWORD=""
