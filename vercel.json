{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=@disparei/web",
  "outputDirectory": "apps/web/.next",
  "regions": ["cle1"],
  "functions": {
    "apps/web/src/app/api/webhooks/**/route.ts": {
      "maxDuration": 30
    }
  }
}
